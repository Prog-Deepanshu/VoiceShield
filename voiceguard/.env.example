# =============================================================================
# VoiceGuard — Environment Configuration
# =============================================================================

# Model Configuration
MODEL_VARIANT=aasist_l          # "aasist" (297K params) or "aasist_l" (85K params)
ENABLE_ENSEMBLE=false           # Enable Wav2Vec2 ensemble verification
WAV2VEC2_MODEL_ID=Hemgg/Deepfake-audio-detection

# Audio Configuration
SAMPLE_RATE=16000
BUFFER_DURATION_SEC=6.0         # Seconds of audio to buffer before analysis

# Inference Configuration
DEVICE=auto                     # "auto", "cuda", "cpu"
MAX_LATENCY_MS=200
ENABLE_HALF_PRECISION=false     # FP16 inference (GPU only)
ENABLE_TORCHSCRIPT=true         # JIT trace optimization

# Risk Thresholds
RISK_THRESHOLD_LOW=0.3          # Below this = LOW risk
RISK_THRESHOLD_HIGH=0.7         # Above this = HIGH risk

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=                        # Leave empty to disable auth
CORS_ORIGINS=*

# Alert Configuration
WEBHOOK_URL=                    # Fraud alert webhook endpoint
WEBHOOK_TIMEOUT_SEC=10

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./logs/audit.jsonl
