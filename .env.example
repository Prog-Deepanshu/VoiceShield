# VoiceShield Environment Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Model Configuration
MODEL_VARIANT=aasist_l
DEVICE=auto
ENABLE_ENSEMBLE=false
ENABLE_TORCHSCRIPT=false

# Decision Thresholds
THRESHOLD_LOW=0.30
THRESHOLD_HIGH=0.70

# Audio Constraints
MAX_UPLOAD_SIZE_MB=50
MIN_AUDIO_DURATION_SEC=0.5
MAX_AUDIO_DURATION_SEC=180.0

# Windowing & Streaming
ENABLE_WINDOWED_ANALYSIS=true
STREAMING_BUFFER_SEC=6.0
STREAMING_OVERLAP_SEC=2.0
