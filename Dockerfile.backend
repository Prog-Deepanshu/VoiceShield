FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY voiceshield/backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu

COPY voiceguard ./voiceguard
COPY voiceshield/backend ./voiceshield/backend

ENV PYTHONPATH="/app/voiceshield/backend:/app/voiceguard"

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "voiceshield.backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
